{"openapi":"3.1.0","info":{"title":"MilestoneEscrow API","description":"Backend API for escrow and bounties","contact":{"name":"Nikhil Sakpal","email":"nikhilsakpal1426@gmail.com"},"version":"1.0.0"},"paths":{"/":{"get":{"summary":"Read Root","operationId":"read_root__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/health":{"get":{"summary":"Health Check","operationId":"health_check_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/bounties":{"get":{"summary":"List Bounties","description":"Returns a list of all bounties including their milestone progress, multi-sponsor authorizations,\nhybrid multi-sig flags, and logistics oracle/phone tracking details.","operationId":"list_bounties_api_bounties_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Create Bounty","description":"Creates a new Bounty with 'LOCKED' status and initializes Milestone rows.\nSupports Multi-Sponsor Pooling: captures and pools arrays of order/authorization IDs.\nSupports Hybrid Multi-Sig: sets requires_human_approval=True if total bounty > $5,000.\nSupports WhatsApp field-worker phone number & logistics oracle tracking number.","operationId":"create_bounty_api_bounties_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BountyCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}":{"get":{"summary":"Get Bounty","description":"Returns a single bounty with all associated milestone rows, pooled sponsor authorizations,\nlogistics tracking, and escrow data.","operationId":"get_bounty_api_bounties__bounty_id__get","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/submit-work":{"post":{"summary":"Submit Work","description":"Submits freelancer work for a milestone:\nAccepts either multipart form data (file uploads: receipts/images/PDFs) or JSON payloads (GitHub URLs).\n1. Fetches the Bounty, Escrow, and specific Milestone.\n2. Runs automated AI QA evaluation:\n   - Multimodal analysis via Gemini 1.5 Pro and Pillow EXIF verification for uploaded receipts.\n   - Code repository cloning and test execution if a GitHub URL is provided.\n3. Persists evaluation outcome to AuditLog.\n4. If passed:\n   - Captures authorization funds into escrow if not yet done.\n   - Disburses ONLY that milestone's specific amount via PayPal Payouts.\n   - Updates milestone to COMPLETED and decrements remaining escrow funds.\n5. Returns evaluation results, extracted receipt details, and updated balance.","operationId":"submit_work_api_bounties__bounty_id__submit_work_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Milestone Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/milestones/{milestone_id}/submit-work":{"post":{"summary":"Submit Work","description":"Submits freelancer work for a milestone:\nAccepts either multipart form data (file uploads: receipts/images/PDFs) or JSON payloads (GitHub URLs).\n1. Fetches the Bounty, Escrow, and specific Milestone.\n2. Runs automated AI QA evaluation:\n   - Multimodal analysis via Gemini 1.5 Pro and Pillow EXIF verification for uploaded receipts.\n   - Code repository cloning and test execution if a GitHub URL is provided.\n3. Persists evaluation outcome to AuditLog.\n4. If passed:\n   - Captures authorization funds into escrow if not yet done.\n   - Disburses ONLY that milestone's specific amount via PayPal Payouts.\n   - Updates milestone to COMPLETED and decrements remaining escrow funds.\n5. Returns evaluation results, extracted receipt details, and updated balance.","operationId":"submit_work_api_bounties__bounty_id__milestones__milestone_id__submit_work_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"path","required":true,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Milestone Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/appeal":{"post":{"summary":"Appeal Rejection","description":"Dispute Resolution / Appeal Route:\nIf a milestone submission was rejected, the user can submit an appeal explanation.\nSpawns the Mediator AI to analyze the original criteria, the auditor's rejection reason,\nand the user's defense to make a binding decision on whether to override the rejection.\nIf overridden, automatically captures authorization and executes the milestone payout\n(or sets to PENDING_ADMIN if Hybrid Multi-Sig is triggered).","operationId":"appeal_rejection_api_bounties__bounty_id__appeal_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Milestone Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppealRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/milestones/{milestone_id}/appeal":{"post":{"summary":"Appeal Rejection","description":"Dispute Resolution / Appeal Route:\nIf a milestone submission was rejected, the user can submit an appeal explanation.\nSpawns the Mediator AI to analyze the original criteria, the auditor's rejection reason,\nand the user's defense to make a binding decision on whether to override the rejection.\nIf overridden, automatically captures authorization and executes the milestone payout\n(or sets to PENDING_ADMIN if Hybrid Multi-Sig is triggered).","operationId":"appeal_rejection_api_bounties__bounty_id__milestones__milestone_id__appeal_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"path","required":true,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Milestone Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppealRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/pending":{"get":{"summary":"Get Pending Admin Milestones","description":"Returns all bounties and milestones currently awaiting human administrator sign-off\nunder the Hybrid Multi-Sig protocol (threshold > $5,000 USD).","operationId":"get_pending_admin_milestones_api_admin_pending_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/admin/bounties/{bounty_id}/milestones/{milestone_id}/approve":{"post":{"summary":"Admin Final Approve","description":"Hybrid Multi-Sig Human Co-Signer Endpoint:\nWhen an administrator clicks 'Final Approve' on the admin dashboard,\nthis triggers the simultaneous capture of all authorized sponsor IDs and\nexecutes the PayPal Payouts API to release the milestone funds.","operationId":"admin_final_approve_api_admin_bounties__bounty_id__milestones__milestone_id__approve_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"path","required":true,"schema":{"type":"integer","title":"Milestone Id"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/AdminApprovalRequest"},{"type":"null"}],"title":"Approval In"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/bounties/{bounty_id}/milestones/{milestone_id}/reject":{"post":{"summary":"Admin Reject Milestone","description":"Allows a human administrator to deny final approval for a high-value milestone.","operationId":"admin_reject_milestone_api_admin_bounties__bounty_id__milestones__milestone_id__reject_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"path","required":true,"schema":{"type":"integer","title":"Milestone Id"}},{"name":"rejection_reason","in":"query","required":false,"schema":{"type":"string","default":"Admin human co-signer rejected payout","title":"Rejection Reason"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/milestones/{milestone_id}/sponsor":{"post":{"summary":"Add Sponsor To Milestone","description":"Multi-Sponsor Pooling Endpoint:\nAllows additional sponsors to contribute authorization IDs to pool funds for a specific milestone.","operationId":"add_sponsor_to_milestone_api_bounties__bounty_id__milestones__milestone_id__sponsor_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"path","required":true,"schema":{"type":"integer","title":"Milestone Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SponsorContribution"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/generate-scope":{"post":{"summary":"Generate Escrow Scope","description":"Conversational Escrow Gen:\nParses natural language requirements into a strict JSON structure of milestones,\ndeadlines, budget allocations, and acceptance criteria using Gemini 1.5 Pro.","operationId":"generate_escrow_scope_api_bounties_generate_scope_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateScopeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/negotiate":{"post":{"summary":"Negotiate Bounty Scope","description":"AI Scope Negotiation Agent:\nTakes the freelancer's counter-offer, retrieves original bounty terms, and uses Gemini 1.5 Pro\nto evaluate budget vs. timeline constraints, returning a balanced JSON compromise.","operationId":"negotiate_bounty_scope_api_bounties__bounty_id__negotiate_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NegotiateScopeRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/negotiate/accept":{"post":{"summary":"Accept Negotiated Compromise","description":"Applies the agreed AI Scope Negotiation compromise to the live database record,\nupdating the bounty budget, acceptance criteria, and replacing milestones with the compromise terms.","operationId":"accept_negotiated_compromise_api_bounties__bounty_id__negotiate_accept_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AcceptCompromiseRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/webhooks/paypal":{"post":{"summary":"Paypal Webhook","description":"PayPal Webhook listener:\nListens for PAYMENT.PAYOUTS-ITEM.SUCCEEDED events, extracts payout_item_id,\nand logs the success.","operationId":"paypal_webhook_webhooks_paypal_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/webhooks/twilio/whatsapp":{"post":{"summary":"Twilio Whatsapp Webhook","description":"WhatsApp Field-Worker Webhook:\n1. Parses incoming images or text from Twilio WhatsApp webhook.\n2. Associates inbound sender's phone number with registered bounty freelancer.\n3. Finds the active milestone.\n4. Downloads attached photo/receipt and sends to Google Gemini 1.5 Pro for validation.\n5. If passed, automatically triggers PayPal Payouts (or sets to PENDING_ADMIN if Multi-Sig threshold).\n6. Sends a formatted success/feedback message back via Twilio (TwiML).","operationId":"twilio_whatsapp_webhook_api_webhooks_twilio_whatsapp_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/oracle/shipping/{tracking_number}":{"get":{"summary":"Get Shipping Oracle Status","description":"External Logistics / Shipping Oracle endpoint:\nReturns the real-time carrier status (DELIVERED, IN_TRANSIT, SHIPPED) for any tracking number.","operationId":"get_shipping_oracle_status_api_oracle_shipping__tracking_number__get","parameters":[{"name":"tracking_number","in":"path","required":true,"schema":{"type":"string","title":"Tracking Number"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/oracle/shipping/{tracking_number}/status":{"post":{"summary":"Update Shipping Oracle Status","description":"Simulates carrier tracking updates (e.g. marking a consignment as DELIVERED in the logistics API).","operationId":"update_shipping_oracle_status_api_oracle_shipping__tracking_number__status_post","parameters":[{"name":"tracking_number","in":"path","required":true,"schema":{"type":"string","title":"Tracking Number"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShippingStatusUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/oracle/poll":{"get":{"summary":"Poll Oracle Manually","description":"External Data Oracle Polling Endpoint:\nTriggers carrier verification check for all active bounties and milestones with tracking numbers.\nAuto-approves milestones and executes payouts when carrier reports 'DELIVERED'.","operationId":"poll_oracle_manually_api_oracle_poll_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Poll Oracle Manually","description":"External Data Oracle Polling Endpoint:\nTriggers carrier verification check for all active bounties and milestones with tracking numbers.\nAuto-approves milestones and executes payouts when carrier reports 'DELIVERED'.","operationId":"poll_oracle_manually_api_oracle_poll_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/bounties/{bounty_id}/ship":{"post":{"summary":"Mark Bounty Shipped","description":"Marks a physical bounty or deliverable as shipped with a carrier tracking number,\nactivating the External Data Oracle.","operationId":"mark_bounty_shipped_api_bounties__bounty_id__ship_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShipRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/milestones/{milestone_id}/ship":{"post":{"summary":"Mark Milestone Shipped","description":"Marks a specific milestone as shipped with its own carrier tracking number.","operationId":"mark_milestone_shipped_api_bounties__bounty_id__milestones__milestone_id__ship_post","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}},{"name":"milestone_id","in":"path","required":true,"schema":{"type":"integer","title":"Milestone Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShipRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/bounties/{bounty_id}/milestones/{milestone_id}/certificate":{"get":{"summary":"Download Escrow Certificate","description":"Downloads the official 'Escrow Verification Certificate' PDF for a completed milestone.\nIf the PDF file has not yet been generated on disk, creates it on-the-fly and serves it.","operationId":"download_escrow_certificate_api_bounties__bounty_id__milestones__milestone_id__certificate_get","parameters":[{"name":"milestone_id","in":"path","required":true,"schema":{"type":"integer","title":"Milestone Id"}},{"name":"bounty_id","in":"path","required":true,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Bounty Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/milestones/{milestone_id}/certificate":{"get":{"summary":"Download Escrow Certificate","description":"Downloads the official 'Escrow Verification Certificate' PDF for a completed milestone.\nIf the PDF file has not yet been generated on disk, creates it on-the-fly and serves it.","operationId":"download_escrow_certificate_api_milestones__milestone_id__certificate_get","parameters":[{"name":"milestone_id","in":"path","required":true,"schema":{"type":"integer","title":"Milestone Id"}},{"name":"bounty_id","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Bounty Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/analytics/predictive-risk/evaluate":{"post":{"summary":"Run Predictive Risk Evaluation","description":"Triggers the Google Gemini Predictive Risk Analytics Engine across all active bounties.\nAssigns Risk Scores (LOW, MEDIUM, HIGH), risk percentages, and risk factors.","operationId":"run_predictive_risk_evaluation_api_analytics_predictive_risk_evaluate_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/bounties/{bounty_id}/risk":{"get":{"summary":"Get Bounty Predictive Risk","description":"Evaluates or returns the Predictive Risk Score for a specific bounty.","operationId":"get_bounty_predictive_risk_api_bounties__bounty_id__risk_get","parameters":[{"name":"bounty_id","in":"path","required":true,"schema":{"type":"integer","title":"Bounty Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"AcceptCompromiseRequest":{"properties":{"compromise_amount_usd":{"type":"number","title":"Compromise Amount Usd"},"compromise_criteria":{"type":"string","title":"Compromise Criteria"},"compromise_milestones":{"items":{"$ref":"#/components/schemas/MilestoneInput"},"type":"array","title":"Compromise Milestones"},"reasoning":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Reasoning"}},"type":"object","required":["compromise_amount_usd","compromise_criteria","compromise_milestones"],"title":"AcceptCompromiseRequest"},"AdminApprovalRequest":{"properties":{"admin_notes":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Admin Notes","default":"Admin human co-signer approval"}},"type":"object","title":"AdminApprovalRequest"},"AppealRequest":{"properties":{"appeal_text":{"type":"string","title":"Appeal Text"},"milestone_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Milestone Id"}},"type":"object","required":["appeal_text"],"title":"AppealRequest"},"BountyCreate":{"properties":{"title":{"type":"string","title":"Title"},"acceptance_criteria":{"type":"string","title":"Acceptance Criteria"},"amount_usd":{"type":"number","title":"Amount Usd"},"freelancer_email":{"type":"string","title":"Freelancer Email"},"freelancer_phone":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Freelancer Phone"},"tracking_number":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Tracking Number"},"shipping_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Shipping Status","default":"NOT_SHIPPED"},"paypal_order_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Paypal Order Id"},"paypal_order_ids":{"items":{"type":"string"},"type":"array","title":"Paypal Order Ids","default":[]},"milestones":{"items":{"$ref":"#/components/schemas/MilestoneInput"},"type":"array","title":"Milestones","default":[]}},"type":"object","required":["title","acceptance_criteria","amount_usd","freelancer_email"],"title":"BountyCreate"},"GenerateScopeRequest":{"properties":{"prompt":{"type":"string","title":"Prompt"}},"type":"object","required":["prompt"],"title":"GenerateScopeRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"MilestoneInput":{"properties":{"description":{"type":"string","title":"Description"},"deadline":{"type":"string","title":"Deadline"},"percentage":{"type":"number","title":"Percentage"},"authorization_ids":{"items":{"type":"string"},"type":"array","title":"Authorization Ids","default":[]},"tracking_number":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Tracking Number"},"shipping_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Shipping Status","default":"NOT_SHIPPED"}},"type":"object","required":["description","deadline","percentage"],"title":"MilestoneInput"},"NegotiateScopeRequest":{"properties":{"counter_offer":{"type":"string","title":"Counter Offer"},"freelancer_email":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Freelancer Email"},"proposed_amount_usd":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Proposed Amount Usd"},"proposed_timeline":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Proposed Timeline"}},"type":"object","required":["counter_offer"],"title":"NegotiateScopeRequest"},"ShipRequest":{"properties":{"tracking_number":{"type":"string","title":"Tracking Number"},"shipping_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Shipping Status","default":"SHIPPED"},"carrier":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Carrier","default":"FedEx Logistics"}},"type":"object","required":["tracking_number"],"title":"ShipRequest"},"ShippingStatusUpdate":{"properties":{"status":{"type":"string","title":"Status"},"carrier":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Carrier"},"city":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"City"},"notes":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Notes"}},"type":"object","required":["status"],"title":"ShippingStatusUpdate"},"SponsorContribution":{"properties":{"paypal_order_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Paypal Order Id"},"authorization_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization Id"},"sponsor_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Sponsor Name","default":"Anonymous Sponsor"},"amount_usd":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Amount Usd"}},"type":"object","title":"SponsorContribution"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}