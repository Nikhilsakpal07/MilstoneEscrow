# Database configuration
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/milestone_escrow

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# Google Antigravity (Gemini) API Key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro

# Frontend Public PayPal Client ID (for .env.local)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

